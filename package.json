{
  "name": "claude-view",
  "version": "1.0.0",
  "private": true,
  "description": "You have 10 Claude sessions running. What are they doing? Live dashboard for Claude Code — monitor every session, track costs, search history, see sub-agents. One command: npx claude-view",
  "type": "module",
  "packageManager": "bun@1.3.7",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:cleanup": "bash scripts/dev-cleanup.sh",
    "dev:web": "turbo dev --filter=@claude-view/web",
    "dev:landing": "turbo dev --filter=@claude-view/landing",
    "cargo:sweep": "bash scripts/cq sweep",
    "disk:report": "bash scripts/worktree-storage.sh",
    "disk:cleanup:orphans": "bash scripts/worktree-storage.sh --remove-orphaned",
    "preview:landing": "turbo build --filter=@claude-view/landing && turbo preview --filter=@claude-view/landing",
    "deploy:landing": "turbo build --filter=@claude-view/landing && cd apps/landing && bunx wrangler pages deploy dist --project-name=claude-view-landing",
    "deploy:share": "turbo build --filter=@claude-view/share && cd apps/share && bunx wrangler pages deploy dist --project-name=claude-view-share-viewer --branch=main --commit-dirty=true",
    "deploy:share:dev": "cd apps/share && bunx vite build --mode dev && bunx wrangler pages deploy dist --project-name=claude-view-share-viewer-dev --branch=main --commit-dirty=true",
    "release:landing": "./scripts/release-landing.sh",
    "storybook": "cd apps/web && bun run storybook",
    "dev:all": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "start": "bun run build:sidecar && cargo run -p claude-view-server --release",
    "dev:server": "bash scripts/dev-server.sh",
    "test:rust": "cargo test --workspace",
    "lint:rust": "cargo clippy --workspace -- -D warnings",
    "lint:all": "turbo lint && cargo clippy --workspace -- -D warnings",
    "ci:local": "./scripts/ci-local.sh",
    "ci:check": "turbo run lint typecheck test --affected",
    "verify:manifests": "node scripts/verify-manifests.mjs",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "build:sidecar": "cd sidecar && (bun install --frozen-lockfile 2>/dev/null || bun install) && bun run build",
    "fmt": "cargo fmt --all",
    "integrity:evidence": "cargo run -p claude-view-core --bin evidence-audit",
    "integrity:evidence:quick": "EVIDENCE_QUICK=1 cargo run -p claude-view-core --bin evidence-audit",
    "clean:db": "rm -f ~/.claude-view/claude-view.db*",
    "cleanupport": "PORTS='47892 5173 3001'; for port in $PORTS; do pids=\"$(lsof -ti tcp:$port)\"; if [ -n \"$pids\" ]; then echo \"Killing $pids listening on port $port\"; kill -9 $pids; else echo \"No process found on port $port\"; fi; done",
    "release": "./scripts/release.sh",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "release:dry-run": "./scripts/release.sh --dry-run",
    "postinstall": "cd sidecar && bun install && cd ../infra/share-worker && bun install",
    "prepare": "node -e \"try{if(require('fs').statSync('.git').isFile())process.exit(0)}catch(_){process.exit(0)}require('child_process').execFileSync('lefthook',['install','--force'],{stdio:'inherit'});\""
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "ai-agents",
    "mcp",
    "dashboard",
    "monitoring",
    "mission-control",
    "developer-tools",
    "cli",
    "session",
    "session-history",
    "session-viewer",
    "session-monitor",
    "search",
    "ripgrep",
    "cost-tracking",
    "analytics",
    "metrics",
    "heatmap",
    "activity-log",
    "reports",
    "fluency-score",
    "sub-agents",
    "subagents",
    "agent-monitor",
    "context-window",
    "cache-countdown",
    "real-time",
    "sse",
    "websocket",
    "conversation-viewer",
    "export",
    "rust",
    "react",
    "axum",
    "sqlite"
  ],
  "homepage": "https://github.com/TextLayer/claude-mission-control",
  "repository": {
    "type": "git",
    "url": "https://github.com/TextLayer/claude-mission-control"
  },
  "bugs": {
    "url": "https://github.com/TextLayer/claude-mission-control/issues"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "concurrently": "^9.1.2",
    "lefthook": "^2.1.1",
    "turbo": "^2"
  }
}
